HIRESENSE_APP_NAME="HireSense AI"
HIRESENSE_APP_VERSION=0.1.0
HIRESENSE_ENVIRONMENT=development
HIRESENSE_DEBUG=false
HIRESENSE_API_PREFIX=/api/v1
HIRESENSE_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Default: backend/.local/data/hiresense.sqlite3 (absolute path resolved by settings).
# Relative SQLite paths resolve from backend/, regardless of shell location.
# HIRESENSE_DATABASE_URL=sqlite:///.local/data/hiresense.sqlite3
HIRESENSE_DATABASE_ECHO=false

# Local-only; never enable for public deployment. Initialize explicitly first.
HIRESENSE_DEVELOPMENT_IDENTITY_ENABLED=false
# HIRESENSE_DEVELOPMENT_OWNER_ID=<UUID printed by python -m app.initialize_owner>

# mock, disabled, ollama, or openai-compatible
HIRESENSE_AI_PROVIDER=mock
# HIRESENSE_LOCAL_AI_ORIGIN=http://127.0.0.1:11434
# HIRESENSE_LOCAL_AI_MODEL=<installed-model-name>
